import time
start_time = time.time()

p = 8199774928871608042708337544048119948869763877494180771439264454529748145441429582582203121408907613809418733464578068940852928832581080954402140996078237
D_u = [5328787344850375935355801613761298335127237107545363985908358622839775156096189733888475039637119506144843100082580867526143502467981077392439237828046530, 3461215900347959864162902188190786501554597425260987435279436756313779171195452163455613859471307870999089759657622780311213420296994098998779831831378604, 6772531533310861189376839198131937069999107022918279227774115517490449189208456583407168177588350780530656704663559330772803616307055145691125924200419583, 5411844560327509846443012062516759417905263317922893272405175308875380553210162646138893283188619128223187101108601927228790770875916331390011841992859378, 6344757294796672798114516229296795810087212469516780821114308382677329862602467316971876960842465878823323074799904255760157588423606245013996343241332535, 1]
u = [441545299160975911770590988966561884830477545862342868934383631463146423397411630664718672150382112634647398389765357866606748902244410352975323192557526, 6499416627015662682237665948228625854781641570769612183790750416522801423903155202283001121087778748972213821209529110609551889124677967373880666842445820, 6742892420635236727267052182921266998243434126949022136845029803468710083156224872319522263117190105911967939868251020116216247764492595163132880838337298, 4222525823720245643154095037459408524017464868697565951652214499194782032656668204597572895433707796827000178412268119884606177442700958884095778069149319, 1132622113823448111619688544427178326727441392521264560256414865104394859777286573925642257213389429492767766359206791969905538891967292793080272722152143, 1]
v = [5397803069593915806502203351539523105166062283423686580782597759246218480256244982021516133020153572677181571031033909105747311505287306234780422802511719, 4716763005140461315521068430791937126628065069515994205488983551743747906371312657682562621172128211881550803531918487564034080495293277397997349847616824, 5396409403806847941003860521389787370365735710079264925444395393158220828999244013186180531839291547815505798208800966511026157356401452445739160383905562, 7502237001929646210341188945679680084616627553966741361556229202113326611963100118204769080439259563726562875860583328439266478856663895094444240332024168, 7410439490496048735166561519941221318999228293621905371702989056420507835123548834526075711246579313681517407310822547212446779922509516950326811788333784]

print("1. Computing candidate orders via Stickelberger lattice...")
K.<z> = CyclotomicField(11)
Fp = GF(p)
# Find primitive 11th root of unity mod p
r = Fp(1)
while r == 1:
    r = Fp.random_element()^((p-1)//11)
r = int(r)

roots = [pow(r, t, p) for t in [6, 7, 8, 9, 10]]
Rx = GF(p)['x']
M = prod(Rx.gen() - rt for rt in roots)

mat = Matrix(ZZ, 10, 10)
for i in range(5):
    mat[i, i] = p
for i in range(5):
    poly = Rx.gen()^i * M
    coeffs = poly.list()
    for j, c in enumerate(coeffs):
        mat[5 + i, j] = int(c)

L = mat.LLL()
v_vec = K(list(L[0]))
print("Found shortest vector in lattice!")
print("v * conj(v) == p?", v_vec * v_vec.conjugate() == p)

candidate_orders = []
for s in [1, -1]:
    for k in range(11):
        pi = s * (z^k) * v_vec
        N = Integer((1 - pi).norm())
        if N not in candidate_orders:
            candidate_orders.append(N)
print(f"Generated {len(candidate_orders)} candidate orders.")

print("2. Finding 8 possible values of e from D_u...")
R.<x> = GF(p)[]
Du = R(D_u)
factors = [q for q, _ in Du.factor()]

def solve_quadratic_mod(Q):
    if Q.degree() == 1:
        x_val = -Q[0]
        C = x_val^11 + GF(p)(1)/GF(p)(4)
        sq = C.sqrt()
        return [R([sq - GF(p)(1)/GF(p)(2)]), R([-sq - GF(p)(1)/GF(p)(2)])]
    else:
        K_ext.<t> = GF(p).extension(Q)
        C = t^11 + K_ext(1)/K_ext(4)
        sq = C.sqrt()
        y1 = sq - K_ext(1)/K_ext(2)
        y2 = -sq - K_ext(1)/K_ext(2)
        return [R(list(y1)), R(list(y2))]

roots_per_factor = [solve_quadratic_mod(Q) for Q in factors]
from itertools import product
all_roots = list(product(*roots_per_factor))
e_list = []
for r_combo in all_roots:
    Dv = CRT(list(r_combo), factors)
    e_list.append(int(Dv[0]))
print(f"Found {len(e_list)} possible values of e.")

print("3. Decrypting ct...")
H = HyperellipticCurve(x^11, 1, "u,v")
J = H.jacobian()(GF(p))
ct_pt = J((R(u), R(v)))

found = False
for e_val in e_list:
    if found: break
    for N in candidate_orders:
        try:
            d = inverse_mod(e_val, N)
            pt = d * ct_pt
            if pt[0].degree() == 1:
                val = int(-pt[0][0])
                flag = bytes.fromhex(hex(val)[2:])
                if b"NNS{" in flag:
                    print("\n" + "="*50)
                    print(f"FLAG FOUND: {flag.decode()}")
                    print("="*50 + "\n")
                    found = True
                    break
        except Exception as exc:
            pass

print(f"Elapsed time: {time.time() - start_time:.2f} seconds")
